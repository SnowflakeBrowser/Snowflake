diff -ruN orig/veil-main/windows/Veil.Windows/App/Tor/TorBrowserEnv.cs veil-main/windows/Veil.Windows/App/Tor/TorBrowserEnv.cs
--- orig/veil-main/windows/Veil.Windows/App/Tor/TorBrowserEnv.cs	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/Veil.Windows/App/Tor/TorBrowserEnv.cs	2026-11-10 13:28:37.043688348 +0000
@@ -0,0 +1,126 @@
+using Microsoft.Web.WebView2.Core;
+
+namespace Veil.Tor;
+
+/// The WebView2 environment used by every Tor window. It is completely separate from Services.Env:
+///  - its own throw-away user-data folder (deleted when the last Tor window closes, and swept at the next start),
+///  - its own browser process, launched with Chromium switches that force ALL of its network traffic through Tor.
+/// Reference counted; one environment is shared by all open Tor windows, each window has its own in-private profile.
+public static class TorBrowserEnv
+{
+    static readonly SemaphoreSlim gate = new(1, 1);
+    static CoreWebView2Environment env;
+    static string folder;
+    static int refs, port;
+
+    public static string Root
+    {
+        get
+        {
+            var d = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Veil", "TorSession");
+            Directory.CreateDirectory(d);
+            return d;
+        }
+    }
+
+    /// Chromium switches for the Tor browser process. Each one is a layer of the "no leaks" design:
+    ///  --proxy-server            every request goes to Tor's SOCKS5 port; if it is down the request FAILS (no DIRECT fallback)
+    ///  --proxy-bypass-list       "<-loopback>" removes Chromium's implicit "localhost goes direct" rule
+    ///  --host-resolver-rules     any lookup Chromium would do itself fails; with socks5:// the proxy resolves names (via Tor)
+    ///  --disable-quic            QUIC/HTTP3 is UDP and cannot be proxied
+    ///  --force-webrtc-ip-handling-policy  WebRTC may not use UDP outside the proxy (no local/public IP leak)
+    public static string BuildArguments(int socksPort) => string.Join(" ", new[]
+    {
+        "--proxy-server=\"socks5://127.0.0.1:" + socksPort + "\"",
+        "--proxy-bypass-list=<-loopback>",
+        "--host-resolver-rules=\"MAP * ~NOTFOUND , EXCLUDE 127.0.0.1\"",
+        "--disable-quic",
+        "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
+        "--no-pings",
+        "--disable-background-networking",
+    });
+
+    public static async Task<CoreWebView2Environment> AcquireAsync(int socksPort)
+    {
+        await gate.WaitAsync();
+        try
+        {
+            if (env != null)
+            {
+                if (port != socksPort) throw new InvalidOperationException("Tor's SOCKS port changed while Tor windows were open.");
+                refs++;
+                return env;
+            }
+            CleanStale(null);
+            var dir = System.IO.Path.Combine(Root, Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(dir);
+            var opts = new CoreWebView2EnvironmentOptions { AdditionalBrowserArguments = BuildArguments(socksPort) };
+            var reg = new CoreWebView2CustomSchemeRegistration("veil") { TreatAsSecure = true, HasAuthorityComponent = true };
+            if (opts.CustomSchemeRegistrations != null) opts.CustomSchemeRegistrations.Add(reg);
+            else
+            {
+                var prop = typeof(CoreWebView2EnvironmentOptions).GetProperty("CustomSchemeRegistrations");
+                if (prop != null && prop.CanWrite) prop.SetValue(opts, new List<CoreWebView2CustomSchemeRegistration> { reg });
+            }
+            env = await CoreWebView2Environment.CreateAsync(null, dir, opts);
+            folder = dir; port = socksPort; refs = 1;
+            return env;
+        }
+        finally { gate.Release(); }
+    }
+
+    /// Called when a Tor window has closed its tabs. The last release drops the environment and deletes the folder.
+    public static async Task ReleaseAsync()
+    {
+        string toDelete;
+        await gate.WaitAsync();
+        try
+        {
+            if (env == null) return;
+            if (--refs > 0) return;
+            toDelete = folder;
+            env = null; folder = null; port = 0;
+        }
+        finally { gate.Release(); }
+
+        // The browser process exits once every WebView2 object is released; its files stay locked until then.
+        GC.Collect(); GC.WaitForPendingFinalizers();
+        _ = Task.Run(async () =>
+        {
+            for (int i = 0; i < 40; i++)
+            {
+                try { if (!Directory.Exists(toDelete)) return; Directory.Delete(toDelete, true); return; }
+                catch { await Task.Delay(1500); if (i % 5 == 4) { GC.Collect(); GC.WaitForPendingFinalizers(); } }
+            }
+        });
+    }
+
+    /// Deletes leftover session folders (crash, forced quit). Called at startup and before a new environment is made.
+    public static void CleanStale(string keep)
+    {
+        try
+        {
+            foreach (var d in Directory.EnumerateDirectories(Root))
+            {
+                if (keep != null && string.Equals(d, keep, StringComparison.OrdinalIgnoreCase)) continue;
+                if (string.Equals(d, folder, StringComparison.OrdinalIgnoreCase)) continue;
+                try { Directory.Delete(d, true); } catch { }
+            }
+        }
+        catch { }
+    }
+
+    /// Synchronous best effort at application exit.
+    public static void DeleteAllNow()
+    {
+        for (int i = 0; i < 6; i++)
+        {
+            try
+            {
+                foreach (var d in Directory.EnumerateDirectories(Root)) Directory.Delete(d, true);
+                return;
+            }
+            catch { Thread.Sleep(500); }
+        }
+    }
+}
diff -ruN orig/veil-main/windows/Veil.Windows/App/Tor/TorControl.cs veil-main/windows/Veil.Windows/App/Tor/TorControl.cs
--- orig/veil-main/windows/Veil.Windows/App/Tor/TorControl.cs	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/Veil.Windows/App/Tor/TorControl.cs	2026-11-10 07:14:33.839909585 +0000
@@ -0,0 +1,103 @@
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+
+namespace Veil.Tor;
+
+/// Minimal client for Tor's control protocol (https://spec.torproject.org/control-spec/).
+/// Only what Veil needs: cookie authentication, GETINFO and SIGNAL. Commands are serialised.
+public sealed class TorControl : IDisposable
+{
+    readonly TcpClient tcp = new();
+    readonly SemaphoreSlim gate = new(1, 1);
+    StreamReader reader;
+    StreamWriter writer;
+
+    /// Connects to 127.0.0.1:port and authenticates with the cookie file Tor writes into its data directory.
+    public static async Task<TorControl> ConnectAsync(int port, string cookieFile, Func<bool> processExited, CancellationToken ct)
+    {
+        var deadline = DateTime.UtcNow.AddSeconds(30);
+        Exception last = null;
+        while (DateTime.UtcNow < deadline)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (processExited()) throw new IOException("Tor exited before it could be controlled.");
+            TorControl c = null;
+            try
+            {
+                if (!File.Exists(cookieFile)) throw new FileNotFoundException("Tor has not written its control cookie yet.");
+                var cookie = File.ReadAllBytes(cookieFile);
+                if (cookie.Length != 32) throw new IOException("Control cookie is incomplete.");
+                c = new TorControl();
+                await c.tcp.ConnectAsync(IPAddress.Loopback, port, ct);
+                var ns = c.tcp.GetStream();
+                c.reader = new StreamReader(ns, new UTF8Encoding(false));
+                c.writer = new StreamWriter(ns, new UTF8Encoding(false)) { NewLine = "\r\n", AutoFlush = true };
+                await c.SendAsync("AUTHENTICATE " + Convert.ToHexString(cookie), ct);
+                return c;
+            }
+            catch (OperationCanceledException) { c?.Dispose(); throw; }
+            catch (Exception ex)
+            {
+                last = ex;
+                c?.Dispose();
+                await Task.Delay(300, ct);
+            }
+        }
+        throw new IOException("Could not connect to Tor's control port: " + last?.Message);
+    }
+
+    /// Sends one command and returns the reply lines (without the status codes and without the final "OK").
+    /// Throws if Tor answers with an error status.
+    public async Task<List<string>> SendAsync(string command, CancellationToken ct = default)
+    {
+        await gate.WaitAsync(ct);
+        try
+        {
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(TimeSpan.FromSeconds(15));
+            await writer.WriteLineAsync(command);
+            var lines = new List<string>();
+            while (true)
+            {
+                var line = await reader.ReadLineAsync(cts.Token) ?? throw new IOException("Tor's control connection was closed.");
+                if (line.Length < 4) continue;
+                var code = line.Substring(0, 3);
+                var sep = line[3];
+                var body = line.Substring(4);
+                if (sep == '+')
+                {
+                    // multi-line data reply, terminated by a line containing a single "."
+                    var sb = new StringBuilder(body).Append('\n');
+                    while (true)
+                    {
+                        var d = await reader.ReadLineAsync(cts.Token) ?? throw new IOException("Tor's control connection was closed.");
+                        if (d == ".") break;
+                        sb.Append(d).Append('\n');
+                    }
+                    lines.Add(sb.ToString());
+                    continue;
+                }
+                if (code[0] == '6') continue;                 // asynchronous event: we never subscribe, ignore defensively
+                if (sep == '-') { lines.Add(body); continue; }
+                if (code != "250") throw new IOException("Tor control error " + code + ": " + body);
+                return lines;                                  // "250 OK"
+            }
+        }
+        finally { gate.Release(); }
+    }
+
+    public async Task<string> GetInfoAsync(string key, CancellationToken ct = default)
+    {
+        var lines = await SendAsync("GETINFO " + key, ct);
+        var prefix = key + "=";
+        foreach (var l in lines)
+            if (l.StartsWith(prefix, StringComparison.Ordinal)) return l.Substring(prefix.Length);
+        throw new IOException("Tor did not answer GETINFO " + key + ".");
+    }
+
+    public void Dispose()
+    {
+        try { tcp.Dispose(); } catch { }
+    }
+}
diff -ruN orig/veil-main/windows/Veil.Windows/App/Tor/TorManager.cs veil-main/windows/Veil.Windows/App/Tor/TorManager.cs
--- orig/veil-main/windows/Veil.Windows/App/Tor/TorManager.cs	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/Veil.Windows/App/Tor/TorManager.cs	2026-11-10 07:19:07.759106740 +0000
@@ -0,0 +1,421 @@
+using System.Diagnostics;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Veil.Tor;
+
+public enum TorState { Stopped, Starting, Connected, Disconnected, Failed }
+
+/// Owns the one tor.exe process shared by all Tor windows (reference counted: started with the first Tor window,
+/// stopped when the last one closes). Tor itself is the unmodified, official binary from the Tor Expert Bundle.
+///
+/// "Connected" is only ever reported after:
+///   1. Tor reports bootstrap 100% and an established circuit (control port), and
+///   2. check.torproject.org, reached *through Tor's SOCKS port*, says IsTor = true.
+public sealed class TorManager
+{
+    public static readonly TorManager Instance = new();
+    TorManager() { }
+
+    public const string CheckApi = "https://check.torproject.org/api/ip";
+
+    readonly object sync = new();
+    readonly SemaphoreSlim gate = new(1, 1);
+    readonly CancellationTokenSource lifetime = new();
+    TorState state = TorState.Stopped;
+    int progress, socksPort, leases;
+    string detail = "";
+    bool stopping;
+    Process proc;
+    TorControl ctl;
+    CancellationTokenSource monitorCts;
+
+    /// Raised on a background thread. Subscribers must marshal to the UI thread themselves.
+    public event Action Changed;
+
+    public TorState State { get { lock (sync) return state; } }
+    public int Progress { get { lock (sync) return progress; } }
+    public string Detail { get { lock (sync) return detail; } }
+    public int SocksPort { get { lock (sync) return socksPort; } }
+
+    // ---------- locations ----------
+    static string BaseDir => System.IO.Path.GetDirectoryName(Environment.ProcessPath ?? "") ?? AppContext.BaseDirectory;
+
+    static string foundRoot;
+
+    public static string FindTorExe()
+    {
+        foreach (var root in new[] { System.IO.Path.Combine(AppContext.BaseDirectory, "tor"), System.IO.Path.Combine(BaseDir, "tor") })
+        {
+            try
+            {
+                if (!Directory.Exists(root)) continue;
+                var exe = Directory.EnumerateFiles(root, "tor.exe", SearchOption.AllDirectories).FirstOrDefault();
+                if (exe != null) { foundRoot = root; return exe; }
+            }
+            catch { }
+        }
+        return null;
+    }
+
+    public static bool IsInstalled => FindTorExe() != null;
+
+    static string TorRoot
+    {
+        get
+        {
+            var d = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Veil", "Tor");
+            Directory.CreateDirectory(d);
+            return d;
+        }
+    }
+
+    static string Log(string msg)
+    {
+        try { File.AppendAllText(System.IO.Path.Combine(TorRoot, "veil-tor.log"), DateTime.Now.ToString("HH:mm:ss ") + msg + "\n"); } catch { }
+        return msg;
+    }
+
+    // ---------- public API ----------
+
+    /// Starts Tor if needed, waits until it is bootstrapped AND verified, and takes a lease. Returns the SOCKS port.
+    /// Every successful call must be paired with Release().
+    public async Task<int> AcquireAsync(CancellationToken ct)
+    {
+        await gate.WaitAsync(ct);
+        try
+        {
+            bool join;
+            lock (sync) join = leases > 0 && state != TorState.Failed;
+            if (!join)
+            {
+                try { await StartLockedAsync(ct); }
+                catch
+                {
+                    bool unused; lock (sync) unused = leases == 0;
+                    if (unused) await StopLockedAsync();
+                    throw;
+                }
+                if (ct.IsCancellationRequested)
+                {
+                    bool unused; lock (sync) unused = leases == 0;
+                    if (unused) await StopLockedAsync();
+                    ct.ThrowIfCancellationRequested();
+                }
+            }
+            lock (sync) { leases++; return socksPort; }
+        }
+        finally { gate.Release(); }
+    }
+
+    /// Waits until the state is Connected (used by windows that joined an already running Tor).
+    public async Task WaitConnectedAsync(CancellationToken ct)
+    {
+        var deadline = DateTime.UtcNow.AddSeconds(150);
+        while (true)
+        {
+            ct.ThrowIfCancellationRequested();
+            var s = State;
+            if (s == TorState.Connected) return;
+            if (s == TorState.Failed || s == TorState.Stopped) throw new IOException(Detail.Length > 0 ? Detail : "Tor is not running.");
+            if (DateTime.UtcNow > deadline) throw new TimeoutException("Timed out waiting for Tor.");
+            await Task.Delay(400, ct);
+        }
+    }
+
+    /// Gives a lease back; the last one stops Tor.
+    public void Release()
+    {
+        bool last;
+        lock (sync) { if (leases > 0) leases--; last = leases == 0; }
+        if (last) _ = Task.Run(async () =>
+        {
+            await gate.WaitAsync();
+            try
+            {
+                bool still; lock (sync) still = leases > 0;
+                if (!still) await StopLockedAsync();
+            }
+            finally { gate.Release(); }
+        });
+    }
+
+    /// "Retry" button: restart Tor after a failure.
+    public async Task RetryAsync()
+    {
+        await gate.WaitAsync();
+        try { await StartLockedAsync(lifetime.Token); }
+        catch (Exception ex) { Log("Retry failed: " + ex.Message); }
+        finally { gate.Release(); }
+    }
+
+    /// Synchronous hard stop used when Veil exits.
+    public void Shutdown()
+    {
+        stopping = true;
+        try { lifetime.Cancel(); } catch { }
+        try { monitorCts?.Cancel(); } catch { }
+        try { if (proc != null && !proc.HasExited) proc.Kill(true); } catch { }
+        try { ctl?.Dispose(); } catch { }
+    }
+
+    // ---------- start / stop ----------
+
+    void Set(TorState s, int pct, string text)
+    {
+        lock (sync) { state = s; progress = pct; detail = text ?? ""; }
+        try { Changed?.Invoke(); } catch { }
+    }
+
+    static int FreePort()
+    {
+        var l = new TcpListener(IPAddress.Loopback, 0);
+        l.Start();
+        int p = ((IPEndPoint)l.LocalEndpoint).Port;
+        l.Stop();
+        return p;
+    }
+
+    static string Q(string path) => "\"" + path.Replace('\\', '/') + "\"";
+
+    async Task StartLockedAsync(CancellationToken ct)
+    {
+        var exe = FindTorExe() ?? throw new FileNotFoundException(
+            "tor.exe was not found next to Veil. Run windows\\scripts\\fetch_tor.ps1 and rebuild (see windows\\README.md).");
+        Set(TorState.Starting, 0, "Starting Tor…");
+        try
+        {
+            try { monitorCts?.Cancel(); } catch { }
+            KillProcess();
+            stopping = false;
+
+            var root = TorRoot;
+            var dataDir = System.IO.Path.Combine(root, "data");
+            var runDir = System.IO.Path.Combine(root, "run");
+            Directory.CreateDirectory(dataDir);
+            Directory.CreateDirectory(runDir);
+
+            int port;
+            lock (sync) { if (leases == 0 || socksPort == 0) socksPort = FreePort(); port = socksPort; }
+            int ctlPort; do { ctlPort = FreePort(); } while (ctlPort == port);
+
+            var cookie = System.IO.Path.Combine(runDir, "control_auth_cookie");
+            try { File.Delete(cookie); } catch { }
+            var torLog = System.IO.Path.Combine(runDir, "tor.log");
+            try { File.Delete(torLog); } catch { }
+            var torrc = System.IO.Path.Combine(runDir, "torrc");
+
+            var rc = new StringBuilder();
+            rc.AppendLine("DataDirectory " + Q(dataDir));
+            rc.AppendLine("SocksPort 127.0.0.1:" + port);            // loopback only
+            rc.AppendLine("ControlPort 127.0.0.1:" + ctlPort);        // loopback only
+            rc.AppendLine("CookieAuthentication 1");
+            rc.AppendLine("CookieAuthFile " + Q(cookie));
+            rc.AppendLine("ClientOnly 1");
+            rc.AppendLine("AvoidDiskWrites 1");
+            rc.AppendLine("SafeLogging 1");
+            rc.AppendLine("Log notice file " + Q(torLog));
+            rc.AppendLine("__OwningControllerProcess " + Environment.ProcessId);   // Tor exits by itself if Veil dies
+            var torDir = System.IO.Path.GetDirectoryName(exe);
+            // geoip data is optional for a client; use it if the bundle ships it (somewhere below the "tor" folder).
+            if (foundRoot != null)
+            {
+                foreach (var geo in new[] { "geoip", "geoip6" })
+                {
+                    var f = Directory.EnumerateFiles(foundRoot, geo, SearchOption.AllDirectories).FirstOrDefault();
+                    if (f != null) rc.AppendLine((geo == "geoip" ? "GeoIPFile " : "GeoIPv6File ") + Q(f));
+                }
+            }
+            File.WriteAllText(torrc, rc.ToString());
+
+            var psi = new ProcessStartInfo(exe)
+            {
+                UseShellExecute = false, CreateNoWindow = true, WorkingDirectory = torDir,
+            };
+            psi.ArgumentList.Add("-f");
+            psi.ArgumentList.Add(torrc);
+            var p = Process.Start(psi) ?? throw new IOException("Could not start tor.exe.");
+            p.EnableRaisingEvents = true;
+            p.Exited += (s, e) => Log("tor.exe exited with code " + SafeExit(p));
+            proc = p;
+            Log("tor.exe started, pid " + p.Id + ", socks " + port);
+
+            ctl?.Dispose();
+            ctl = await TorControl.ConnectAsync(ctlPort, cookie, () => p.HasExited, ct);
+
+            // 1. wait for bootstrap = 100%
+            var deadline = DateTime.UtcNow.AddSeconds(120);
+            while (true)
+            {
+                ct.ThrowIfCancellationRequested();
+                if (p.HasExited) throw new IOException("Tor stopped while connecting (see " + torLog + ").");
+                var phase = await ctl.GetInfoAsync("status/bootstrap-phase", ct);
+                var m = Regex.Match(phase, @"PROGRESS=(\d+)");
+                int pct = m.Success ? int.Parse(m.Groups[1].Value) : 0;
+                var sm = Regex.Match(phase, "SUMMARY=\"([^\"]*)\"");
+                Set(TorState.Starting, pct, "Connecting to the Tor network… " + pct + "%" + (sm.Success ? " (" + sm.Groups[1].Value + ")" : ""));
+                if (pct >= 100) break;
+                if (DateTime.UtcNow > deadline) throw new TimeoutException("Tor did not finish connecting within two minutes. Your network may be blocking Tor.");
+                await Task.Delay(500, ct);
+            }
+
+            // 2. a circuit must actually exist
+            for (int i = 0; ; i++)
+            {
+                ct.ThrowIfCancellationRequested();
+                if ((await ctl.GetInfoAsync("status/circuit-established", ct)).Trim() == "1") break;
+                if (i > 60) throw new TimeoutException("Tor could not build a circuit.");
+                await Task.Delay(500, ct);
+            }
+
+            // 3. independent end-to-end check through the SOCKS port
+            Set(TorState.Starting, 100, "Verifying the Tor connection…");
+            var (isTor, _) = await VerifyAsync(port, ct);
+            if (!isTor) throw new IOException("check.torproject.org says traffic through Tor's SOCKS port is NOT using Tor. Refusing to continue.");
+
+            Set(TorState.Connected, 100, "Connected to Tor");
+            StartMonitor();
+        }
+        catch (OperationCanceledException)
+        {
+            KillProcess();
+            Set(TorState.Stopped, 0, "");
+            throw;
+        }
+        catch (Exception ex)
+        {
+            Log("start failed: " + ex.Message);
+            KillProcess();
+            Set(TorState.Failed, 0, ex.Message);
+            throw;
+        }
+    }
+
+    static string SafeExit(Process p) { try { return p.ExitCode.ToString(); } catch { return "?"; } }
+
+    void KillProcess()
+    {
+        try { ctl?.Dispose(); } catch { }
+        ctl = null;
+        var p = proc;
+        proc = null;
+        if (p == null) return;
+        stopping = true;
+        try { if (!p.HasExited) p.Kill(true); } catch { }
+        try { p.WaitForExit(2000); } catch { }
+        try { p.Dispose(); } catch { }
+    }
+
+    async Task StopLockedAsync()
+    {
+        stopping = true;
+        try { monitorCts?.Cancel(); } catch { }
+        try { if (ctl != null) await ctl.SendAsync("SIGNAL HALT"); } catch { }
+        try { if (proc != null) await Task.Run(() => proc.WaitForExit(1500)); } catch { }
+        KillProcess();
+        lock (sync) { socksPort = 0; }
+        Set(TorState.Stopped, 0, "");
+    }
+
+    // ---------- verification ----------
+
+    /// Asks the Tor Project's own check service, through the given SOCKS port, whether the request arrived via Tor.
+    /// .NET's SOCKS5 support sends the host name to the proxy (no local DNS lookup).
+    public static async Task<(bool isTor, string ip)> VerifyAsync(int port, CancellationToken ct)
+    {
+        Exception last = null;
+        for (int attempt = 0; attempt < 3; attempt++)
+        {
+            ct.ThrowIfCancellationRequested();
+            try
+            {
+                using var handler = new SocketsHttpHandler
+                {
+                    Proxy = new WebProxy(new Uri("socks5://127.0.0.1:" + port)),
+                    UseProxy = true, UseCookies = false, AllowAutoRedirect = false,
+                    ConnectTimeout = TimeSpan.FromSeconds(30),
+                };
+                using var http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(45) };
+                var json = await http.GetStringAsync(CheckApi, ct);
+                using var doc = JsonDocument.Parse(json);
+                bool isTor = doc.RootElement.TryGetProperty("IsTor", out var t) && t.ValueKind == JsonValueKind.True;
+                string ip = doc.RootElement.TryGetProperty("IP", out var i) ? i.GetString() : "";
+                return (isTor, ip);
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (Exception ex) { last = ex; await Task.Delay(1500, ct); }
+        }
+        throw new IOException("Could not reach check.torproject.org through Tor: " + last?.Message);
+    }
+
+    // ---------- monitoring / recovery ----------
+
+    void StartMonitor()
+    {
+        try { monitorCts?.Cancel(); } catch { }
+        var cts = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
+        monitorCts = cts;
+        _ = Task.Run(() => MonitorAsync(cts.Token));
+    }
+
+    async Task MonitorAsync(CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            try { await Task.Delay(3000, ct); } catch { return; }
+            try
+            {
+                if (proc == null || proc.HasExited) throw new IOException("The Tor process stopped.");
+                bool up = (await ctl.GetInfoAsync("status/circuit-established", ct)).Trim() == "1";
+                var s = State;
+                if (!up)
+                {
+                    if (s == TorState.Connected) Set(TorState.Disconnected, 0, "Tor lost its connection to the network. Browsing is blocked until it comes back.");
+                    continue;
+                }
+                if (s == TorState.Disconnected)
+                {
+                    // Network is back: do not unblock until the end-to-end check passes again.
+                    var (isTor, _) = await VerifyAsync(SocksPort, ct);
+                    if (isTor) Set(TorState.Connected, 100, "Connected to Tor");
+                }
+            }
+            catch (OperationCanceledException) { return; }
+            catch (Exception ex)
+            {
+                if (stopping || ct.IsCancellationRequested) return;
+                Log("monitor: " + ex.Message);
+                Set(TorState.Disconnected, 0, "Tor stopped unexpectedly. Browsing is blocked while Veil restarts it…");
+                await RecoverAsync();
+                return;                       // a successful restart starts a fresh monitor
+            }
+        }
+    }
+
+    async Task RecoverAsync()
+    {
+        int[] delays = { 1000, 4000, 10000 };
+        foreach (var d in delays)
+        {
+            try { await Task.Delay(d, lifetime.Token); } catch { return; }
+            bool wanted; lock (sync) wanted = leases > 0;
+            if (!wanted || stopping && State == TorState.Stopped) return;
+            await gate.WaitAsync();
+            try
+            {
+                lock (sync) wanted = leases > 0;
+                if (!wanted) return;
+                await StartLockedAsync(lifetime.Token);
+                return;
+            }
+            catch (OperationCanceledException) { return; }
+            catch { /* StartLockedAsync already set Failed; try again after the next delay */ }
+            finally { gate.Release(); }
+        }
+        // still failing after three tries: stay in Failed until the user presses Retry
+        if (State != TorState.Stopped) Set(TorState.Failed, 0, "Tor could not be restarted. Browsing stays blocked. " + Detail);
+    }
+}
diff -ruN orig/veil-main/windows/Veil.Windows/App/Tor/TorPages.cs veil-main/windows/Veil.Windows/App/Tor/TorPages.cs
--- orig/veil-main/windows/Veil.Windows/App/Tor/TorPages.cs	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/Veil.Windows/App/Tor/TorPages.cs	2026-11-10 07:15:42.154046917 +0000
@@ -0,0 +1,51 @@
+namespace Veil.Tor;
+
+/// The only pages a Tor window shows itself. They are plain HTML drawn with NavigateToString:
+/// no veil:// bridge, no access to history, bookmarks, settings or downloads of the normal windows.
+public static class TorPages
+{
+    const string Shell = @"<!doctype html><html><head><meta charset='utf-8'><title>__TITLE__</title>
+<meta name='viewport' content='width=device-width,initial-scale=1'>
+<meta http-equiv='Content-Security-Policy' content=""default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:"">
+<meta name='color-scheme' content='dark light'>
+<style>
+:root{--bg:#f6f4f9;--panel:#fff;--line:#0002;--text:#1b1b1f;--mute:#66666f;--tor:#7d4698}
+@media (prefers-color-scheme:dark){:root{--bg:#17131c;--panel:#221b2b;--line:#fff2;--text:#ececf0;--mute:#9a9aa6;--tor:#b98ad4}}
+*{box-sizing:border-box}html,body{height:100%;margin:0}
+body{background:radial-gradient(900px 520px at 50% -10%,#7d469833,transparent 70%),var(--bg);color:var(--text);
+font:14px/1.55 'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;display:flex;align-items:center;justify-content:center}
+main{width:min(640px,90vw);display:flex;flex-direction:column;align-items:center;margin-top:-5vh;text-align:center}
+.onion{font-size:54px;line-height:1}h1{font-weight:600;font-size:26px;margin:12px 0 4px}
+.ok{color:var(--tor);font-weight:600}.mute{color:var(--mute)}
+form{width:100%;margin:26px 0 22px}
+input{width:100%;height:50px;border-radius:25px;border:1px solid var(--line);background:var(--panel);color:var(--text);font:inherit;font-size:16px;padding:0 22px;outline:none}
+input:focus{border-color:var(--tor)}
+.note{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 18px;text-align:left;font-size:13px;color:var(--mute)}
+.note b{color:var(--text)}
+</style></head><body><main>__BODY__</main></body></html>";
+
+    static string Wrap(string title, string body) => Shell.Replace("__TITLE__", title).Replace("__BODY__", body);
+
+    /// Start page of a Tor tab. Only ever shown after the connection has been verified.
+    public static string NewTab() => Wrap("New Tor tab", @"
+<div class='onion'>🧅</div><h1>Tor window</h1>
+<div class='ok'>Connected to Tor · verified</div>
+<form id='f'><input id='q' type='text' placeholder='Search DuckDuckGo or enter address' autocomplete='off' spellcheck='false' autofocus></form>
+<div class='note'><b>What this does:</b> sites and your network see Tor, not your IP address, and this window keeps its cookies and history to itself
+and deletes them when it closes.<br><br>
+<b>What it does not do:</b> this is not Tor Browser. Your browser fingerprint (fonts, screen, engine version) can still make you recognisable,
+and anything you sign in to identifies you. Don’t use it where anonymity is a matter of safety.</div>
+<script>
+function go(v){v=v.trim();if(!v)return;var u;
+ if(/^[a-z][a-z0-9+.-]*:\/\//i.test(v))u=v;
+ else if(!/\s/.test(v)&&/^[^\s\/]+\.[a-z0-9-]{2,}(\/.*)?$/i.test(v))u=(/\.onion(\/|$)/i.test(v)?'http://':'https://')+v;
+ else u='https://duckduckgo.com/?q='+encodeURIComponent(v);
+ location.href=u;}
+document.getElementById('f').addEventListener('submit',function(e){e.preventDefault();go(document.getElementById('q').value);});
+</script>");
+
+    /// Shown instead of Veil's normal internal pages (history, settings, …), which must not be reachable from a Tor window.
+    public static string Unavailable() => Wrap("Not available", @"
+<div class='onion'>🧅</div><h1>Not available in a Tor window</h1>
+<p class='mute'>History, bookmarks, downloads and settings belong to your normal windows and are kept out of Tor windows on purpose.</p>");
+}
