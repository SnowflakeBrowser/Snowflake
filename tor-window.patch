diff -ruN orig/veil-main/windows/scripts/check_tor_traffic.ps1 veil-main/windows/scripts/check_tor_traffic.ps1
--- orig/veil-main/windows/scripts/check_tor_traffic.ps1	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/scripts/check_tor_traffic.ps1	2026-11-10 07:19:58.740336984 +0000
@@ -0,0 +1,47 @@
+<#
+ Leak check for Tor windows. Run it in PowerShell WHILE you browse in a Tor window.
+ It finds every msedgewebview2.exe process that belongs to Tor windows (their user-data folder is under
+ %LOCALAPPDATA%\Veil\TorSession) and lists their network sockets.
+
+ PASS  = every TCP connection of those processes goes to 127.0.0.1 / ::1 (that is Tor's SOCKS port) and nothing else.
+ FAIL  = any TCP connection to a non-loopback address, i.e. a direct connection that bypassed Tor.
+ UDP sockets are listed too: Chromium may keep local sockets open, but with the Tor switches it must not send
+ anything to the internet over UDP (QUIC and WebRTC are disabled); a non-loopback UDP *remote* cannot be shown by
+ Windows, so use Wireshark/pktmon with the filter in windows\TOR-WINDOW.md if you need packet-level proof.
+
+ Usage:  .\windows\scripts\check_tor_traffic.ps1 [-Seconds 30]
+#>
+param([int]$Seconds = 30)
+$sess = (Join-Path $env:LOCALAPPDATA "Veil\TorSession").ToLowerInvariant()
+$bad = @{}
+$seen = 0
+$end = (Get-Date).AddSeconds($Seconds)
+Write-Host "Sampling for $Seconds s. Browse in the Tor window now (open several sites and tabs)..."
+while ((Get-Date) -lt $end) {
+  $procs = Get-CimInstance Win32_Process -Filter "Name='msedgewebview2.exe'" |
+           Where-Object { $_.CommandLine -and $_.CommandLine.ToLowerInvariant().Contains($sess) }
+  foreach ($p in $procs) {
+    foreach ($c in (Get-NetTCPConnection -OwningProcess $p.ProcessId -ErrorAction SilentlyContinue)) {
+      if ($c.State -in 'Listen','Bound') { continue }
+      $seen++
+      $ra = $c.RemoteAddress
+      if ($ra -notin '127.0.0.1','::1','0.0.0.0','::') { $bad["$($p.ProcessId) -> ${ra}:$($c.RemotePort) ($($c.State))"] = $true }
+    }
+  }
+  Start-Sleep -Milliseconds 700
+}
+$procs = Get-CimInstance Win32_Process -Filter "Name='msedgewebview2.exe'" |
+         Where-Object { $_.CommandLine -and $_.CommandLine.ToLowerInvariant().Contains($sess) }
+Write-Host ("Tor-window WebView2 processes found: {0}; TCP connections observed: {1}" -f @($procs).Count, $seen)
+if (@($procs).Count -eq 0) { Write-Warning "No Tor window browser process found - is a Tor window open?"; exit 2 }
+foreach ($p in $procs) {
+  foreach ($u in (Get-NetUDPEndpoint -OwningProcess $p.ProcessId -ErrorAction SilentlyContinue)) {
+    Write-Host ("  UDP socket (pid {0}): {1}:{2}" -f $p.ProcessId, $u.LocalAddress, $u.LocalPort)
+  }
+}
+if ($bad.Count -gt 0) {
+  Write-Host "`nFAIL: direct (non-loopback) TCP connections from Tor-window processes:" -ForegroundColor Red
+  $bad.Keys | Sort-Object | ForEach-Object { Write-Host "  $_" -ForegroundColor Red }
+  exit 1
+}
+Write-Host "`nPASS: no direct TCP connections; everything went to the local Tor SOCKS port." -ForegroundColor Green
diff -ruN orig/veil-main/windows/scripts/fetch_tor.ps1 veil-main/windows/scripts/fetch_tor.ps1
--- orig/veil-main/windows/scripts/fetch_tor.ps1	1970-01-01 00:00:00.000000000 +0000
+++ veil-main/windows/scripts/fetch_tor.ps1	2026-11-10 07:19:37.471324708 +0000
@@ -0,0 +1,92 @@
+<#
+ Downloads the official Tor Expert Bundle (the tor.exe the Tor Project builds for Tor Browser) into
+ windows\Veil.Windows\ThirdParty\tor so that the build copies it next to Veil.exe.
+
+ Usage:   .\windows\scripts\fetch_tor.ps1                 # newest stable release
+          .\windows\scripts\fetch_tor.ps1 -Version 15.0.5 # a specific Tor Browser release number
+
+ What it checks, and it stops on any mismatch:
+   1. SHA-256 of the download against sha256sums-signed-build.txt from the Tor Project
+   2. the OpenPGP signature (.asc) of the download, made by the "Tor Browser Developers" key
+      (needs GnuPG: winget install GnuPG.GnuPG).  -SkipSignature skips this and ONLY keeps the hash check,
+      which proves nothing against someone who controls the download server. Don't ship that way.
+ The version number is the Tor Browser release; the bundle contains the matching tor daemon.
+#>
+param(
+  [string]$Version = "",
+  [switch]$SkipSignature
+)
+$ErrorActionPreference = "Stop"
+$ProgressPreference = "SilentlyContinue"
+
+# Fingerprint of the Tor Browser Developers signing key (https://support.torproject.org/tbb/how-to-verify-signature/)
+$ExpectedFpr = "EF6E286DDA85EA2A4BA7DE684E2C6E8793298290"
+
+$dest = Join-Path $PSScriptRoot "..\Veil.Windows\ThirdParty\tor"
+$work = Join-Path ([IO.Path]::GetTempPath()) ("veil-tor-" + [Guid]::NewGuid().ToString("N"))
+New-Item -ItemType Directory -Force $work | Out-Null
+
+try {
+  if (-not $Version) {
+    $meta = Invoke-RestMethod "https://aus1.torproject.org/torbrowser/update_3/release/downloads.json"
+    $Version = [string]$meta.version
+    if (-not $Version) { throw "Could not read the current version from downloads.json. Pass -Version (see https://www.torproject.org/download/tor/)." }
+  }
+  Write-Host "Tor Expert Bundle for Tor Browser $Version (windows-x86_64)"
+
+  $file = "tor-expert-bundle-windows-x86_64-$Version.tar.gz"
+  $bases = @("https://dist.torproject.org/torbrowser/$Version", "https://archive.torproject.org/tor-package-archive/torbrowser/$Version")
+
+  function Get-First($name, $out) {
+    foreach ($b in $bases) {
+      try { Invoke-WebRequest "$b/$name" -OutFile $out -UseBasicParsing; return $true } catch { }
+    }
+    return $false
+  }
+
+  $tgz = Join-Path $work $file
+  if (-not (Get-First $file $tgz)) { throw "Could not download $file from dist.torproject.org or archive.torproject.org." }
+  $sums = Join-Path $work "sha256sums-signed-build.txt"
+  if (-not (Get-First "sha256sums-signed-build.txt" $sums)) { throw "Could not download sha256sums-signed-build.txt." }
+
+  # 1. hash
+  $line = Get-Content $sums | Where-Object { $_ -match [regex]::Escape($file) + "\s*$" } | Select-Object -First 1
+  if (-not $line) { throw "$file is not listed in sha256sums-signed-build.txt." }
+  $want = ($line -split "\s+")[0].ToLowerInvariant()
+  $got = (Get-FileHash $tgz -Algorithm SHA256).Hash.ToLowerInvariant()
+  if ($want -ne $got) { throw "SHA-256 mismatch for $file`n  expected $want`n  got      $got" }
+  Write-Host "SHA-256 OK  ($got)"
+
+  # 2. signature
+  if ($SkipSignature) {
+    Write-Warning "Signature check skipped. Only the SHA-256 from the same server was verified."
+  } else {
+    $gpg = Get-Command gpg -ErrorAction SilentlyContinue
+    if (-not $gpg) { throw "GnuPG (gpg) is required to verify the signature. Install it (winget install GnuPG.GnuPG) or pass -SkipSignature (not recommended)." }
+    $asc = "$tgz.asc"
+    if (-not (Get-First "$file.asc" $asc)) { throw "Could not download $file.asc." }
+    $home_ = Join-Path $work "gnupg"; New-Item -ItemType Directory -Force $home_ | Out-Null
+    & gpg --homedir $home_ --batch --auto-key-locate "nodefault,wkd" --locate-keys torbrowser@torproject.org 2>&1 | Out-Null
+    $fprs = (& gpg --homedir $home_ --batch --with-colons --fingerprint torbrowser@torproject.org) | Where-Object { $_ -like "fpr:*" } | ForEach-Object { ($_ -split ":")[9] }
+    if ($fprs -notcontains $ExpectedFpr) { throw "The key fetched for torbrowser@torproject.org does not have the expected fingerprint $ExpectedFpr (got: $($fprs -join ', '))." }
+    $out = & gpg --homedir $home_ --batch --status-fd 1 --verify $asc $tgz 2>&1
+    if (-not ($out -match "VALIDSIG")) { throw "Signature verification FAILED:`n$out" }
+    Write-Host "OpenPGP signature OK (key $ExpectedFpr)"
+  }
+
+  # extract
+  $x = Join-Path $work "x"; New-Item -ItemType Directory -Force $x | Out-Null
+  & tar -xzf $tgz -C $x
+  if ($LASTEXITCODE -ne 0) { throw "tar failed to extract the bundle." }
+  $exe = Get-ChildItem $x -Recurse -Filter tor.exe | Select-Object -First 1
+  if (-not $exe) { throw "tor.exe not found inside the bundle." }
+
+  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force }
+  New-Item -ItemType Directory -Force $dest | Out-Null
+  Copy-Item (Join-Path $x "*") $dest -Recurse -Force
+  Set-Content (Join-Path $dest "VERSION.txt") "Tor Browser $Version / $file`nsha256 $got`nFetched $(Get-Date -Format s)"
+  Write-Host "`nInstalled to $dest`nNow build:  .\windows\scripts\build_windows.ps1"
+}
+finally {
+  Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue
+}
